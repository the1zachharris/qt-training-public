<MudStack Spacing="1">
    <MudStack Row Justify="Justify.SpaceBetween">
        <MudText>Subtotal</MudText>
        <MudText Class="money">@Subtotal.ToCurrency()</MudText>
    </MudStack>
    <MudStack Row Justify="Justify.SpaceBetween">
        <MudText>Tax</MudText>
        <MudText Class="money">@Tax.ToCurrency()</MudText>
    </MudStack>
    @if (DeliveryFee > 0)
    {
        <MudStack Row Justify="Justify.SpaceBetween">
            <MudText>Delivery fee</MudText>
            <MudText Class="money">@DeliveryFee.ToCurrency()</MudText>
        </MudStack>
    }
    <MudDivider />
    <MudStack Row Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">Total</MudText>
        <MudText Typo="Typo.h6" Class="money">@Total.ToCurrency()</MudText>
    </MudStack>
</MudStack>

@code {
    [Parameter] public decimal Subtotal { get; set; }
    [Parameter] public decimal Tax { get; set; }
    [Parameter] public decimal DeliveryFee { get; set; }
    [Parameter] public decimal Total { get; set; }
}
