@if (Status is not null)
{
    <MudAlert Severity="@Status.Severity"
              ContentAlignment="HorizontalAlignment.Left"
              Class="@Class"
              role="@Role">
        @Status.Message
    </MudAlert>
}

@code {
    [Parameter]
    public StatusMessage? Status { get; set; }

    [Parameter]
    public string? Class { get; set; }

    // The alert is inserted only when there is something to say, so a live-region role on the new
    // element is announced by screen readers (WCAG 4.1.3). Errors and warnings interrupt; the rest wait.
    private string Role => Status?.Severity is Severity.Error or Severity.Warning ? "alert" : "status";
}
