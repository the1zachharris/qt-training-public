<MudAppBar Class="app-bar" Fixed="true">
    @if (DisplayNavMenuIcon)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Size="Size.Large" Color="Color.Inherit" Edge="Edge.Start" OnClick="@OnMenuClick" Class="app-bar-menu-button" aria-label="Navigation menu" />
    }
    <MudIcon Icon="@Icons.Material.Filled.LocalPizza" Color="Color.Primary" Size="Size.Large" Class="app-bar-logo cursor-pointer" @onclick="OnHeaderLogoClick" />
    <MudDivider Class="app-bar-divider mx-2 my-3" FlexItem="true" Vertical="true" />
    <MudText Typo="Typo.h6" Class="app-bar-title">@AppTitle</MudText>
    <MudSpacer />
    @ContentSection
</MudAppBar>

@code {
    [Parameter]
    public string? AppTitle { get; set; }

    [Parameter]
    public RenderFragment? ContentSection { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnMenuClick { get; set; }

    [Parameter]
    public bool DisplayNavMenuIcon { get; set; } = false;

    [Inject]
    public NavigationManager? NavigationManager { get; set; }

    private void OnHeaderLogoClick()
    {
        NavigationManager?.NavigateTo("/");
    }
}
