@page "/kitchen"

<PageTitle>Kitchen - Neighborhood Pizza</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <MudPaper Class="page-shell">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap" Class="mb-3">
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="page-title">Kitchen Orders</MudText>
            <MudSpacer />
            @if (LastUpdated is { } updated)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@($"Updated {updated:h:mm:ss tt}")</MudText>
            }
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@Refreshing" OnClick="@RefreshAsync">Refresh</MudButton>
        </MudStack>
        @* Read out by screen readers when a refresh brings in new orders; the board itself shows them. *@
        <div role="status" aria-live="polite" class="mud-sr-only">@Arrivals</div>
        <StatusAlert Status="@RefreshProblem" Class="mb-3" />
        <StatusAlert Status="@ActionProblem" Class="mb-3" />
        @if (Orders is null)
        {
            @if (Loading)
            {
                <MudProgressCircular Indeterminate Class="my-4" />
            }
        }
        else
        {
            <MudGrid Spacing="6">
                <MudItem xs="12" md="7">
                    @* A plain h2 with MudText's classes, because focus moves here when the last New order is marked Ready. *@
                    <h2 @ref="_newHeading" tabindex="-1" class="mud-typography mud-typography-h6 mb-3">@($"New ({Orders.New.Count})")</h2>
                    @if (Orders.New.Count == 0)
                    {
                        <MudText Class="mud-text-secondary">No orders waiting.</MudText>
                    }
                    <MudStack Spacing="3">
                        @foreach (OrderDetails order in Orders.New)
                        {
                            <KitchenOrderCard @key="order.Id" @ref="_newCards[order.Id]" Order="@order" Busy="@IsMarking(order.Id)" OnMarkReady="@MarkReadyAsync" />
                        }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@($"Ready ({Orders.Ready.Count})")</MudText>
                    @if (Orders.Ready.Count == 0)
                    {
                        <MudText Class="mud-text-secondary">Nothing ready yet.</MudText>
                    }
                    <MudStack Spacing="3">
                        @foreach (OrderDetails order in Orders.Ready)
                        {
                            <KitchenOrderCard @key="order.Id" Order="@order" />
                        }
                    </MudStack>
                </MudItem>
            </MudGrid>
        }
    </MudPaper>
</MudContainer>
