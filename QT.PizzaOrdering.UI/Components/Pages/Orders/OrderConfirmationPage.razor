@page "/orders/{OrderId:guid}"
@using Microsoft.Extensions.Options
@using QT.PizzaOrdering.UI.Shared.Configs
@implements IDisposable

<PageTitle>Order Confirmation - Neighborhood Pizza</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
    <MudPaper Class="page-shell">
        <StatusAlert Status="@Status" Class="mb-3" />
        @if (Loading)
        {
            <MudProgressCircular Indeterminate Class="my-4" />
        }
        else if (Order is not null)
        {
            <MudStack Row AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h5" HtmlTag="h1" Class="page-title customer-name">@($"Thanks, {Order.CustomerName}! Your order is in.")</MudText>
                    <MudText Typo="Typo.h6">@($"Order {PizzaText.OrderNumber(Order.OrderNumber)}")</MudText>
                </MudStack>
            </MudStack>

            <MudAlert Severity="@(Order.Status == OrderStatus.Ready ? Severity.Success : Severity.Info)" Variant="Variant.Outlined" Class="mb-4">
                @(Order.Status == OrderStatus.Ready
                    ? "Your order is ready for pickup. Pay at the counter when you arrive."
                    : "We are making your order now. Pay at the counter when you pick up.")
            </MudAlert>

            <MudStack Spacing="3">
                @foreach (PricedPizza pizza in Order.Pizzas)
                {
                    <MudStack Row Justify="Justify.SpaceBetween" Spacing="4">
                        <div><PizzaSummary Pizza="@pizza" ShowQuantity /></div>
                        <MudText Class="money">@pizza.LineTotal.ToCurrency()</MudText>
                    </MudStack>
                }
                <MudDivider />
                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6">Total</MudText>
                    <MudText Typo="Typo.h6" Class="money">@Order.Total.ToCurrency()</MudText>
                </MudStack>
            </MudStack>

            <MudStack Row Class="mt-6">
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/menu" StartIcon="@Icons.Material.Filled.LocalPizza">Start Another Order</MudButton>
            </MudStack>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/menu" StartIcon="@Icons.Material.Filled.LocalPizza">Back to the Menu</MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public Guid OrderId { get; set; }
    [Inject] private IPizzaOrderingHttpClient Client { get; set; } = default!;
    [Inject] private IOptions<OrderStatusConfig> StatusOptions { get; set; } = default!;

    private CancellationTokenSource? _watching;

    private OrderDetails? Order { get; set; }
    private bool Loading { get; set; } = true;
    private StatusMessage? Status { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        StopWatching();
        Loading = true;
        Status = null;

        ClientResult<OrderDetails> result = await Client.GetOrderAsync(OrderId);
        Order = result.Data;
        if (result.IsFailure)
        {
            Status = result.Error?.Status == System.Net.HttpStatusCode.NotFound
                ? StatusMessage.Warning("We could not find that order.")
                : StatusMessage.Error($"The order could not be loaded. {CustomerMessages.TryAgainSoon}");
        }

        Loading = false;

        if (Order is { Status: not OrderStatus.Ready })
        {
            _watching = new CancellationTokenSource();
            _ = WatchForReadyAsync(Order.Id, _watching.Token);
        }
    }

    /// <summary>
    /// Checks the order again on a timer until the kitchen marks it Ready, so a customer waiting
    /// on this page sees "ready for pickup" without reloading. A failed check is skipped quietly:
    /// the page still shows the last status it knew, and the next check tries again.
    /// </summary>
    private async Task WatchForReadyAsync(Guid orderId, CancellationToken ct)
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(StatusOptions.Value.RefreshSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                ClientResult<OrderDetails> result = await Client.GetOrderAsync(orderId, ct);
                if (ct.IsCancellationRequested || result.IsFailure)
                    continue;

                Order = result.Data;
                await InvokeAsync(StateHasChanged);
                if (Order?.Status == OrderStatus.Ready)
                    return;
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // The customer left the page or opened a different order; stop checking.
        }
    }

    private void StopWatching()
    {
        _watching?.Cancel();
        _watching?.Dispose();
        _watching = null;
    }

    public void Dispose() => StopWatching();
}
