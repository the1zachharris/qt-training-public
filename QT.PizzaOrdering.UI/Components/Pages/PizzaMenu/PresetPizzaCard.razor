<MudCard Outlined Elevation="0" Class="preset-card">
    <MudCardHeader Class="pb-0">
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Preset.Name</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2">@Preset.Description</MudText>
        <MudRadioGroup T="int" Value="@_sizeId" ValueChanged="@OnSizeChanged" Class="mt-2">
            @foreach (PizzaSize size in Menu.Sizes)
            {
                <MudRadio T="int" Value="@size.Id" Color="Color.Primary" Dense>@($"{size.Name} ({size.Inches}\")")</MudRadio>
            }
        </MudRadioGroup>
    </MudCardContent>
    <MudCardActions>
        <MudText Typo="Typo.h6" Class="ml-2">@Price.ToCurrency()</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => OnCustomize.InvokeAsync(Selection))">Customize</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="ml-2" OnClick="@(() => OnAdd.InvokeAsync(Selection))">Add</MudButton>
    </MudCardActions>
</MudCard>

@code {
    private int _sizeId;

    [Parameter, EditorRequired] public MenuCatalog Menu { get; set; } = default!;
    [Parameter, EditorRequired] public PresetPizza Preset { get; set; } = default!;

    /// <summary>Add the preset as-is, in the size picked on the card.</summary>
    [Parameter] public EventCallback<PizzaSelection> OnAdd { get; set; }

    /// <summary>Open the builder starting from this preset, in the size picked on the card.</summary>
    [Parameter] public EventCallback<PizzaSelection> OnCustomize { get; set; }

    private PizzaSelection Selection => PizzaSelections.FromPreset(Preset, _sizeId);

    /// <summary>The price of this preset in the chosen size, shown before it is added.</summary>
    private decimal Price => PizzaPricer.Price(Menu, Selection) is { IsSuccess: true } result ? result.Value.UnitPrice : 0m;

    protected override void OnInitialized()
    {
        _sizeId = Menu.Sizes[0].Id;
    }

    private void OnSizeChanged(int sizeId) => _sizeId = sizeId;
}
