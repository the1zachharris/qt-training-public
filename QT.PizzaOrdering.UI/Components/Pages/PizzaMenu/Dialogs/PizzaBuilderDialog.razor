<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5">@MudDialog.Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="5">
            <div>
                <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">Size</MudText>
                <MudRadioGroup T="int" @bind-Value="_sizeId">
                    @foreach (PizzaSize size in Menu.Sizes)
                    {
                        <MudRadio T="int" Value="@size.Id" Color="Color.Primary">@($"{size.Name} ({size.Inches}\") - {size.Price.ToCurrency()}")</MudRadio>
                    }
                </MudRadioGroup>
            </div>
            <div>
                <MudText Typo="Typo.subtitle1" Style="font-weight: 500;">Toppings</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-1">Pick as many as you like, or none for a plain cheese pizza.</MudText>
                <MudChipSet T="int" @bind-SelectedValues="_toppingIds" SelectionMode="SelectionMode.MultiSelection" CheckMark Variant="Variant.Outlined" Color="Color.Primary">
                    @foreach (Topping topping in Menu.Toppings)
                    {
                        <MudChip T="int" Value="@topping.Id" Text="@($"{topping.Name} +{topping.Price.ToCurrency()}")" />
                    }
                </MudChipSet>
            </div>
            <div style="max-width: 180px;">
                <MudNumericField T="int" @bind-Value="_quantity" Label="Quantity" Min="1" Max="@PizzaPricer.MaxQuantity" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudStack Spacing="0" Class="ml-4">
            <MudText Typo="Typo.h6">@(Priced is null ? "—" : Priced.LineTotal.ToCurrency())</MudText>
            @if (Priced is { Quantity: > 1 })
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@($"{Priced.UnitPrice.ToCurrency()} each")</MudText>
            }
        </MudStack>
        <MudSpacer />
        <MudButton Color="Color.Dark" Variant="Variant.Filled" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="@(Priced is null)" OnClick="@Confirm">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>
