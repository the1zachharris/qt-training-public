@page "/checkout"

<PageTitle>Place Your Order - Neighborhood Pizza</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
    <MudPaper Class="page-shell">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="page-title">Place Your Order</MudText>
        </MudStack>
        <StatusAlert Status="@Status" Class="mb-3" />
        @if (Loading)
        {
            <MudProgressCircular Indeterminate Class="my-4" />
        }
        else if (Cart.IsEmpty)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="my-12">
                <MudText Typo="Typo.h6" HtmlTag="p">There is nothing to order yet.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/menu" StartIcon="@Icons.Material.Filled.LocalPizza">See the Menu</MudButton>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3">
                @foreach (CartItem item in Cart.Items)
                {
                    <MudStack Row Justify="Justify.SpaceBetween" Spacing="4" @key="item.Id">
                        <div><PizzaSummary Pizza="@item.Pizza" ShowQuantity /></div>
                        <MudText Class="money">@item.Pizza.LineTotal.ToCurrency()</MudText>
                    </MudStack>
                }
                <MudDivider />
                <MudStack Row Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6" HtmlTag="p">Total</MudText>
                    <MudText Typo="Typo.h6" HtmlTag="p" Class="money">@Cart.Total.ToCurrency()</MudText>
                </MudStack>
            </MudStack>

            <MudTextField T="string" @bind-Value="CustomerName" Label="Name for the order" Required Immediate
                          Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" Class="mt-6"
                          HelperText="We will call this name when your order is ready."
                          Error="@(NameError is not null)" ErrorText="@NameError"
                          OnKeyDown="@OnNameKeyDownAsync"
                          autocomplete="name" />

            <MudAlert Severity="Severity.Info" Dense Variant="Variant.Outlined" Class="mt-4">
                Pickup only. Pay at the counter when you arrive.
            </MudAlert>

            <MudStack Row Class="mt-4" Spacing="2">
                <MudButton Variant="Variant.Text" Color="Color.Default" Href="/cart" StartIcon="@Icons.Material.Filled.ArrowBack">Back</MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" Disabled="@(!CanPlaceOrder)" OnClick="@PlaceOrderAsync">
                    @if (Submitting)
                    {
                        <MudProgressCircular Indeterminate Size="Size.Small" Class="mr-2" />
                    }
                    @($"Place Order · {Cart.Total.ToCurrency()}")
                </MudButton>
            </MudStack>
        }
    </MudPaper>
</MudContainer>
